{
  "env": {
    "CGO_ENABLED": "0",
    "GOFLAGS": "-mod=readonly"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Edit(/**)",
      "Bash(make ci)",
      "Bash(make build)",
      "Bash(make build-all)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make race)",
      "Bash(make test-list)",
      "Bash(make check-test-list)",
      "Bash(make test-harness)",
      "Bash(make test-one PKG=*)",
      "Bash(make test-integration PKG=*)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --stat *)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached *)",
      "Bash(git diff --name-only)",
      "Bash(git diff --name-only *)",
      "Bash(git diff --name-status)",
      "Bash(git diff --name-status *)",
      "Bash(git diff HEAD)",
      "Bash(git diff HEAD *)",
      "Bash(git diff main)",
      "Bash(git diff main *)",
      "Bash(git diff origin/main)",
      "Bash(git diff origin/main *)",
      "Bash(git diff * HEAD)",
      "Bash(git log)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline *)",
      "Bash(git log --stat)",
      "Bash(git log --stat *)",
      "Bash(git log -1)",
      "Bash(git log -1 *)",
      "Bash(git log -n *)",
      "Bash(git show *)",
      "Bash(go list *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Read(../**)",
      "Read(**/.env*)",
      "Read(**/secrets)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/Library/**)",
      "Read(//Users/*/Library/**)",
      "Edit(../**)",
      "Edit(/.git)",
      "Edit(/.git/**)",
      "Edit(**/.env*)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/Makefile)",
      "Edit(/.golangci.yml)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/adr/**)",
      "Edit(**/*.proto)",
      "Edit(**/*.pb.go)",
      "Edit(/scripts/ticket)",
      "Edit(/schemas/**)",
      "Edit(**/.gitattributes)",
      "Edit(/.gitmodules)",
      "Edit(/go.work)",
      "Edit(/go.work.*)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(go run *)",
      "Bash(*-exec *)",
      "Bash(*-exec=*)",
      "Bash(*-toolexec *)",
      "Bash(*-toolexec=*)",
      "Bash(*-vettool *)",
      "Bash(*-vettool=*)",
      "Bash(go * -mod *)",
      "Bash(go * -mod=*)",
      "Bash(go * -o *)",
      "Bash(go * -o=*)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git reset *)",
      "Bash(git * reset *)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(git hook *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git --git-dir *)",
      "Bash(git --work-tree *)",
      "Bash(*--git-dir=*)",
      "Bash(*--work-tree=*)",
      "Bash(git *--force*)",
      "Bash(git *--forc *)",
      "Bash(*--no-index *)",
      "Bash(*--no-index)",
      "Bash(*--no-index=*)",
      "Bash(*--output *)",
      "Bash(*--output=*)",
      "Bash(*--outp *)",
      "Bash(*--outp=*)",
      "Bash(git diff /*)",
      "Bash(git diff ~/*)",
      "Bash(git diff ../*)",
      "Bash(git diff * /*)",
      "Bash(git diff * ~/*)",
      "Bash(git diff * ../*)",
      "Bash(git * -- /*)",
      "Bash(git * -- ~/*)",
      "Bash(git * -- ../*)",
      "Bash(git * /dev/*)",
      "Bash(git commit * --am)",
      "Bash(git commit * --am *)",
      "Bash(git commit * --ame)",
      "Bash(git commit * --ame *)",
      "Bash(git commit * --amend)",
      "Bash(git commit * --amend *)",
      "Bash(git commit * -F*)",
      "Bash(git commit * --fil*)",
      "Bash(git commit * --templ*)",
      "Bash(make *-f *)",
      "Bash(make *-f*)",
      "Bash(make *--file *)",
      "Bash(make *--file=*)",
      "Bash(make *--mak*)",
      "Bash(make *-C *)",
      "Bash(make *-C*)",
      "Bash(make *--dir*)",
      "Bash(make *--ev*)",
      "Bash(make *SHELL=*)",
      "Bash(make *SHELL:=*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(brew *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(cargo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(find *-ok*)",
      "Bash(find *-fprint*)",
      "Bash(find *-fls*)",
      "Bash(rg *--pre*)"
    ]
  }
}
