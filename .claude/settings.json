{
  "env": {
    "CGO_ENABLED": "0",
    "GOFLAGS": "-mod=readonly"
  },
  "permissions": {
    "deny": [
      "Read(../**)",
      "Read(**/.env*)",
      "Read(**/secrets)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/.git)",
      "Edit(/.git/**)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "Bash(git remote *)"
    ]
  }
}
