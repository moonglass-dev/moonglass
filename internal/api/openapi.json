{
  "components": {
    "schemas": {
      "EnvironmentInfo": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "When the environment was created, RFC 3339",
            "type": "string"
          },
          "id": {
            "description": "Environment id",
            "type": "string"
          },
          "name": {
            "description": "Environment name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "EnvironmentsCreateIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Environment name",
            "type": "string"
          },
          "project": {
            "description": "Project name",
            "type": "string"
          }
        },
        "required": [
          "project",
          "name"
        ],
        "type": "object"
      },
      "EnvironmentsListOut": {
        "additionalProperties": false,
        "properties": {
          "environments": {
            "description": "Environments of the project",
            "items": {
              "$ref": "#/components/schemas/EnvironmentInfo"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "environments"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProjectInfo": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "When the project was created, RFC 3339",
            "type": "string"
          },
          "id": {
            "description": "Project id",
            "type": "string"
          },
          "name": {
            "description": "Project name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "ProjectsCreateIn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Project name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ProjectsListOut": {
        "additionalProperties": false,
        "properties": {
          "projects": {
            "description": "Projects of the caller's org",
            "items": {
              "$ref": "#/components/schemas/ProjectInfo"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "projects"
        ],
        "type": "object"
      },
      "ServerInfo": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "When the server enrolled, RFC 3339",
            "type": "string"
          },
          "id": {
            "description": "Server id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at"
        ],
        "type": "object"
      },
      "ServersListOut": {
        "additionalProperties": false,
        "properties": {
          "servers": {
            "description": "Servers enrolled in the caller's org",
            "items": {
              "$ref": "#/components/schemas/ServerInfo"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "servers"
        ],
        "type": "object"
      },
      "ServiceInfo": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "When the service was created, RFC 3339",
            "type": "string"
          },
          "id": {
            "description": "Service id",
            "type": "string"
          },
          "name": {
            "description": "Service name",
            "type": "string"
          },
          "server": {
            "description": "Server id the service runs on",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "server",
          "created_at"
        ],
        "type": "object"
      },
      "ServicesCreateIn": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "description": "Environment name",
            "type": "string"
          },
          "name": {
            "description": "Service name",
            "type": "string"
          },
          "project": {
            "description": "Project name",
            "type": "string"
          },
          "server": {
            "description": "Server id of the caller's org",
            "type": "string"
          }
        },
        "required": [
          "project",
          "environment",
          "name",
          "server"
        ],
        "type": "object"
      },
      "ServicesListOut": {
        "additionalProperties": false,
        "properties": {
          "services": {
            "description": "Services of the environment",
            "items": {
              "$ref": "#/components/schemas/ServiceInfo"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "services"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Moonglass",
    "version": "1"
  },
  "openapi": "3.1.0",
