#!/usr/bin/env bash
# Pipeline gates: record a child's result, lock the approved tests, run every check.
# Run with no arguments for the usage. The logic is tools/pipeline (docs/pipeline/README.md).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Build, then exec the binary: `go run` turns every failing exit code into 1,
# and callers branch on 1 (rejected), 2 (error) and 3 (stop file).
bin=.pipeline/bin/pipeline
mkdir -p .pipeline/bin
go build -o "$bin.$$" ./tools/pipeline
mv -f "$bin.$$" "$bin"
exec "$bin" verify "$@"
