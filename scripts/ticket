#!/usr/bin/env bash
# Ticket harness: runs one ticket through its pipeline. See docs/harness.md.
#
#   scripts/ticket <start|tests|impl|verify|pr|review|fix|status|run|reset> <ID> [--approve] [--yes] [--dry-run]
#
# Prints exactly one JSON line: {id, state, needs_human, reason?}. Details go to .ticket/<ID>/.
# Exit status: 0 progress or done, 1 needs a human, 2 usage or internal error.
set -u -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ROOT=${TICKET_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')}
CLAUDE_BIN=${CLAUDE_BIN:-claude}
CI_CMD=${TICKET_CI_CMD:-make ci}
BASE_BRANCH=${TICKET_BASE_BRANCH:-main}
MAX_NEW_LINES=800

# Per-call caps, in dollars of API-equivalent usage and in seconds.
BUDGET_PLAN=${TICKET_BUDGET_PLAN:-1.5}
BUDGET_TESTS=${TICKET_BUDGET_TESTS:-3}
BUDGET_IMPL=${TICKET_BUDGET_IMPL:-5}
BUDGET_FIX=${TICKET_BUDGET_FIX:-3}
BUDGET_REVIEW=${TICKET_BUDGET_REVIEW:-4}
SECS_CLAUDE=${TICKET_SECS_CLAUDE:-2400}
SECS_GO=${TICKET_SECS_GO:-900}
SECS_CI=${TICKET_SECS_CI:-1800}

# Paths no ticket may change unless its `allow` list names them. Keep in step with .claude/settings.json.
# GD: diff flags that keep gate diffs textual and free of repository-configured drivers.
GD=(-a --no-ext-diff --no-textconv)

is_protected() {
	case "$1" in
	.github/* | .claude/* | Makefile | .golangci.yml | AGENTS.md | CLAUDE.md | docs/adr/* | *.proto | *.pb.go | scripts/ticket | schemas/*) return 0 ;;
	.gitattributes | */.gitattributes | .gitmodules | go.work*) return 0 ;;
	esac
	return 1
}

is_trusted_core() {
	case "$1" in
	internal/protocol/* | internal/policy/* | internal/keys/* | internal/auth/* | internal/store/* | internal/registry/* | scripts/install* | deploy/systemd/*) return 0 ;;
	esac
	return 1
}

# ---------------------------------------------------------------- results

ID=""
TD=""
WT=""
R_STATE=""
R_NH=false
R_REASON=""

emit() {
	jq -nc --arg id "$ID" --arg state "$R_STATE" --argjson nh "$R_NH" --arg reason "$R_REASON" \
		'{id: $id, state: $state, needs_human: $nh} + (if $reason == "" then {} else {reason: $reason} end)'
}

die() {
	R_STATE=error
	R_NH=true
	R_REASON=$*
	emit
	exit 2
}

# set_result STATE NEEDS_HUMAN REASON: records the outcome of a stage.
set_result() {
	R_STATE=$1
	R_NH=$2
	R_REASON=${3:-}
	if [ -f "$TD/state.json" ]; then
		st_set state "$R_STATE"
		st_set reason "$R_REASON"
		st_setj needs_human "$R_NH"
	fi
}

st_get() { jq -r --arg k "$1" '.[$k] // empty' "$TD/state.json"; }
st_set() { jq --arg k "$1" --arg v "$2" '.[$k] = $v' "$TD/state.json" >"$TD/state.tmp" && mv "$TD/state.tmp" "$TD/state.json"; }
st_setj() { jq --arg k "$1" --argjson v "$2" '.[$k] = $v' "$TD/state.json" >"$TD/state.tmp" && mv "$TD/state.tmp" "$TD/state.json"; }
log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" >>"$TD/harness.log"; }

require_state() {
	local cur want
	cur=$(st_get state)
	for want in "$@"; do [ "$cur" = "$want" ] && return 0; done
	die "ticket is in state '$cur'; this step needs one of: $*"
}

# ---------------------------------------------------------------- ticket file

fm() { awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit } NR > 1 { print }' "$1"; }
unquote() { sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"; }
fm_scalar() { fm "$1" | sed -n "s/^$2:[[:space:]]*//p" | head -n 1 | unquote; }
fm_list() {
	fm "$1" | awk -v k="$2" '
		/^[[:space:]]*#/ { next }
		$0 ~ "^" k ":" { inlist = 1; next }
		inlist && /^[[:space:]]+-[[:space:]]/ { sub(/^[[:space:]]+-[[:space:]]+/, ""); print; next }
		inlist && /^[^[:space:]]/ { inlist = 0 }' | unquote
}
ticket_title() { awk '/^---$/ { c++; next } c >= 2 && /^# / { sub(/^# /, ""); print; exit }' "$1"; }

T_LEVEL="" T_SPEC="" T_TITLE="" T_PACKAGES="" T_TESTS="" T_READS="" T_ALLOW="" T_DEPS=""

load_ticket() { # file
	local f=$1
	[ -f "$f" ] || die "ticket file $f not found"
	fm "$f" >/dev/null || die "$f has no frontmatter; copy docs/tickets/TEMPLATE.md"
	[ "$(fm_scalar "$f" id)" = "$ID" ] || die "$f: frontmatter id must be $ID"
	T_LEVEL=$(fm_scalar "$f" level)
	case "$T_LEVEL" in core | standard | light) ;; *) die "$f: level must be core, standard or light" ;; esac
	T_SPEC=$(fm_scalar "$f" spec)
	T_TITLE=$(ticket_title "$f")
	[ -n "$T_TITLE" ] || die "$f: needs a '# <title>' heading after the frontmatter"
	T_PACKAGES=$(fm_list "$f" packages)
	T_TESTS=$(fm_list "$f" tests)
	T_READS=$(fm_list "$f" reads)
	T_ALLOW=$(fm_list "$f" allow)
	T_DEPS=$(fm_list "$f" dependencies)
	[ -n "$T_PACKAGES" ] || die "$f: packages must list at least one path"
	local line
	while IFS= read -r line; do
		[ -z "$line" ] && continue
		case "$line" in "./"*" "*) ;; *) die "$f: tests entries look like './pkg/path TestName', got '$line'" ;; esac
	done <<EOF
$T_TESTS
EOF
}

models() { # sets IMPL_MODEL, REVIEW_MODEL (empty for no review)
	case "$T_LEVEL" in
	core) IMPL_MODEL=sonnet REVIEW_MODEL=opus ;;
	standard) IMPL_MODEL=sonnet REVIEW_MODEL=sonnet ;;
	light) IMPL_MODEL=sonnet REVIEW_MODEL="" ;;
	esac
}

# ---------------------------------------------------------------- process helpers

# Scrubbed environment for everything that runs agent-written code or the agent itself.
ENVB=(env -i "PATH=$PATH" "HOME=$HOME" "USER=${USER:-}" "TERM=${TERM:-dumb}" "LANG=${LANG:-en_US.UTF-8}" "TMPDIR=${TMPDIR:-/tmp}")
ENVP=("${ENVB[@]}" "GOFLAGS=-mod=readonly")
# Go settings the dependency fetch takes from the caller (proxy, checksum database, private modules, caches). GOFLAGS is not one of them.
GO_FETCH_VARS="GOPROXY GOSUMDB GOPRIVATE GONOPROXY GONOSUMDB GOINSECURE GOMODCACHE GOPATH"
claude_env() {
	CENV=("${ENVP[@]}")
	local v
	for v in $(env | sed -n -E 's/^((CLAUDE|ANTHROPIC)_[A-Z0-9_]*)=.*/\1/p'); do
		CENV+=("$v=${!v}")
	done
}

# with_timeout SECONDS CMD...: gtimeout when installed, else a perl process-group fallback (macOS has no timeout).
with_timeout() {
	local secs=$1
	shift
	if command -v gtimeout >/dev/null 2>&1; then
		gtimeout --kill-after=10 "$secs" "$@"
		return
	fi
	perl -e '
		my $secs = shift @ARGV;
		my $pid = fork();
		die "fork: $!" unless defined $pid;
		if (!$pid) { setpgrp(0, 0); exec @ARGV or exit 127; }
		$SIG{ALRM} = sub { kill "TERM", -$pid; sleep 5; kill "KILL", -$pid; exit 124; };
		alarm $secs;
		waitpid($pid, 0);
		my $s = $?;
		exit(($s & 127) ? 128 + ($s & 127) : $s >> 8);
	' "$secs" "$@"
}

# deny_covers RULE PATH: does the Edit deny rule match the repository-relative path? Only /x and **/x rules do.
deny_covers() {
	local g=${1#Edit(}
	g=${g%)}
	case "$g" in
	/*)
		g=${g#/}
		g=${g//\*\*/\*}
		[[ $2 == $g ]]
		;;
	'**/'*)
		g=${g#'**/'}
		[[ $2 == $g || $2 == */$g ]]
		;;
	*) return 1 ;;
	esac
}

# guarded PATH: the harness guard itself. A ticket's allow list never reaches it.
guarded() {
	case "$1" in .claude | .claude/* | scripts/ticket) return 0 ;; esac
	return 1
}

# session_settings: writes $TD/session-settings.json, the project settings for one write session.
# An Edit deny rule is dropped when the ticket's allow list names a protected path it covers, except
# the rules that cover .claude/ or scripts/ticket. Rooted /x rules become absolute paths, because a
# --settings file resolves them against its own directory and not against the worktree.
session_settings() {
	local base=$WT/.claude/settings.json rule a x wt drop=()
	[ -f "$base" ] || die "$base is missing"
	wt=$(cd "$WT" && pwd -P)
	while IFS= read -r rule; do
		case "$rule" in "Edit("*) ;; *) continue ;; esac
		deny_covers "$rule" .claude/settings.json && continue
		deny_covers "$rule" scripts/ticket && continue
		while IFS= read -r a; do
			a=${a%/}
			[ -n "$a" ] || continue
			guarded "$a" && continue
			for x in "$a" "$a/x"; do
				if is_protected "$x" && deny_covers "$rule" "$x"; then
					drop+=("$rule")
					break 2
				fi
			done
		done <<EOF
$T_ALLOW
EOF
	done < <(jq -r '.permissions.deny[]' "$base")
	jq --arg wt "$wt" '
		def rooted: if test("^(Edit|Read)\\(/([^/]|$)") then sub("^(?<t>Edit|Read)\\(/"; "\(.t)(/" + $wt + "/") else . end;
		.permissions.deny |= ((. - $ARGS.positional) | map(rooted)) | .permissions.allow |= map(rooted)
	' "$base" --args ${drop[@]+"${drop[@]}"} >"$TD/session-settings.json" || die "cannot write $TD/session-settings.json"
}

# claude_call STEP MODEL EFFORT BUDGET SCHEMA MODE: runs one headless session in the worktree.
# The structured result is saved to $TD/STEP.json. Returns 1 and sets R_REASON on failure.
claude_call() {
	local step=$1 model=$2 effort=$3 budget=$4 schema=$5 mode=$6
	local prompt=$TD/$step.prompt.md out=$TD/$step.out.json err=$TD/$step.err.log rc
	local schema_json
	schema_json=$(jq -c . "$ROOT/schemas/$schema.json") || die "schemas/$schema.json is missing or invalid"
	claude_env
	log "claude $step model=$model effort=$effort"
	case "$mode" in
	plan) # read-only, no shell
		(cd "$WT" && with_timeout "$SECS_CLAUDE" "${CENV[@]}" "$CLAUDE_BIN" -p --model "$model" --effort "$effort" \
			--output-format json --json-schema "$schema_json" --setting-sources project --strict-mcp-config \
			--permission-mode dontAsk --no-session-persistence --disable-slash-commands --max-budget-usd "$budget" \
			--tools Read,Grep,Glob <"$prompt" >"$out" 2>"$err")
		;;
	review) # read-only plus git diff/log
		(cd "$WT" && with_timeout "$SECS_CLAUDE" "${CENV[@]}" "$CLAUDE_BIN" -p --model "$model" --effort "$effort" \
			--output-format json --json-schema "$schema_json" --setting-sources project --strict-mcp-config \
			--permission-mode dontAsk --no-session-persistence --disable-slash-commands --max-budget-usd "$budget" \
			--tools Read,Grep,Glob,Bash --disallowedTools Edit Write NotebookEdit "Bash(git add:*)" "Bash(git commit:*)" "Bash(make:*)" "Bash(go:*)" "Bash(cat:*)" "Bash(rg:*)" "Bash(grep:*)" "Bash(find:*)" "Bash(head:*)" "Bash(wc:*)" "Bash(ls:*)" <"$prompt" >"$out" 2>"$err")
		;;
	*) # write: .claude/settings.json, with the ticket's allow list applied to the protected-path denies
		session_settings
		(cd "$WT" && with_timeout "$SECS_CLAUDE" "${CENV[@]}" "$CLAUDE_BIN" -p --model "$model" --effort "$effort" \
			--output-format json --json-schema "$schema_json" --setting-sources "" --settings "$TD/session-settings.json" --strict-mcp-config \
			--permission-mode dontAsk --no-session-persistence --disable-slash-commands --max-budget-usd "$budget" \
			--disallowedTools WebFetch WebSearch <"$prompt" >"$out" 2>"$err")
		;;
	esac
	rc=$?
	if [ $rc -ne 0 ]; then
		R_REASON="claude exited $rc during $step (124 means timeout); see .ticket/$ID/$step.err.log"
		return 1
	fi
	if ! jq -e '.is_error != true and (.structured_output | type == "object")' "$out" >/dev/null 2>&1; then
		R_REASON="claude returned no structured_output during $step; see .ticket/$ID/$step.out.json"
		return 1
	fi
	jq -c '.structured_output' "$out" >"$TD/$step.json"
	jq -c --arg s "$step" '{step: $s, usd: .total_cost_usd, turns: .num_turns}' "$out" >>"$TD/usage.log"
	return 0
}

# ---------------------------------------------------------------- prompts

# bash_rules: the shell rules for every session that has Bash. Permission rules match one command at a time.
bash_rules() {
	cat <<'EOF'
Run exactly one command per Bash call. Never chain commands with ';', '|' or '&&'.
If a command is denied, retry with a simpler allowed single command; one denial does not mean Bash is unavailable.
Report blocked only after several distinct allowed commands have failed.
EOF
}

ticket_text() { cat "$TD/ticket.md"; }
reads_text() {
	printf 'AGENTS.md\n'
	[ -n "$T_SPEC" ] && printf '%s\n' "$T_SPEC"
	[ -n "$T_READS" ] && printf '%s\n' "$T_READS"
	return 0
}

prompt_plan() {
	cat >"$TD/plan.prompt.md" <<EOF
Ticket $ID:
$(ticket_text)

Read these files, then do not edit anything:
$(reads_text)

Propose: the files to create or change; types and function signatures; each acceptance test by name, the file it lives in, and what it asserts; ambiguities in the ticket (blocking or not, each with your proposed answer); whether a contract must change (proto, registry operations, agent.toml schema, storage schema, an ADR); any new dependency.
Only what this ticket needs. No abstractions, options or hooks for later tickets. Answer in the required JSON shape.
EOF
}

prompt_tests() {
	cat >"$TD/tests.prompt.md" <<EOF
Write only the failing acceptance tests for ticket $ID, following the plan below. Do not write any non-test code.
Table-driven tests, failure messages that show expected and actual values. Run them and confirm they fail (a compile failure for a missing package counts). Touch only these packages:
$T_PACKAGES
Do not touch go.mod, protected paths, or existing test lines. Commit as "$ID: tests". Then stop.
$(bash_rules)

Ticket:
$(ticket_text)

Read first:
$(reads_text)

Plan:
$(cat "$TD/plan.json")
EOF
}

prompt_impl() { # optional failure text in $1
	{
		cat <<EOF
Implement ticket $ID only, on the current branch.
EOF
		if [ "$T_LEVEL" = core ]; then
			echo "The failing tests are already committed and locked. Make them pass. Do not edit them."
		else
			echo "Red-green: write the acceptance tests first, run them, see them fail, then implement until they pass."
		fi
		cat <<EOF
Touch only these paths:
$T_PACKAGES
Stop and report blocked before changing a contract (proto, registry operations, agent.toml schema, storage schema) or an ADR.
The harness already ran go get and go mod tidy for the ticket's dependencies, so go.mod and go.sum may be changed and uncommitted: commit them with your work. You cannot run go get, go install or go mod tidy; do not try. A module you need that is not in the ticket's dependencies is a new dependency: stop and report blocked.
No placeholders, no TODOs, no fallback or legacy paths, no code for later tickets. Errors are wrapped with context and say what to do.
Never weaken, skip or delete an existing test. Run make ci, run make test-list, commit as "$ID: $T_TITLE" (git add the files first), and leave the tree clean. Then stop.
$(bash_rules)

Ticket:
$(ticket_text)

Read first:
$(reads_text)
EOF
		[ -s "$TD/plan.json" ] && printf '\nApproved plan:\n%s\n' "$(cat "$TD/plan.json")"
		[ -n "${1:-}" ] && printf '\nThe harness verification of your previous attempt failed. Fix exactly this and nothing else:\n%s\n' "$1"
	} >"$TD/impl.prompt.md"
}

prompt_review() {
	cat >"$TD/review.prompt.md" <<EOF
You are reviewing a change for Moonglass, a deploy platform whose server agent has root-equivalent access to users' machines. You did not write this code and have no access to the conversation that did.
Read docs/threat-model.md, the ticket below, and its spec. Then run: git diff $BASE HEAD
Report only:
- correctness bugs
- threat-model violations (use the checklist in docs/threat-model.md)
- acceptance cases with no test
- tests that were deleted, weakened, skipped or hard-coded
- fallback paths, dead code, or code for later tickets
- dependencies added without an ADR
Severity: blocker = wrong behaviour or a security hole; major = acceptance case untested or a rule broken; minor = anything else worth saying.
For each finding give the file, line, what breaks, and a concrete failing scenario, plus a test that would catch it. No style comments. Do not propose new abstractions or features. If you find nothing, say so: verdict approve with no findings.

Ticket:
$(ticket_text)

Spec and reads:
$(reads_text)
EOF
}

prompt_fix() {
	cat >"$TD/fix.prompt.md" <<EOF
Address these review findings for ticket $ID on the current branch. For each one, either fix it with a test that fails first, or explain precisely why it is not a defect (in notes). Change nothing else. Never weaken, skip or delete an existing test.
Run make ci, run make test-list, commit as "$ID: address review" (git add the files first), and leave the tree clean. Then stop.
$(bash_rules)

Findings:
$(jq '[.findings[] | select(.severity == "blocker" or .severity == "major")]' "$TD/review.json")
EOF
}

# ---------------------------------------------------------------- gates

changed() { git -C "$WT" diff "${GD[@]}" --no-renames --name-status "$BASE" HEAD; }

under() { # path entry
	local e=${2%/}
	[ "$1" = "$e" ] && return 0
	case "$1" in "$e"/*) return 0 ;; esac
	return 1
}
in_list() { # path, newline-separated entries
	local e
	while IFS= read -r e; do
		[ -n "$e" ] && under "$1" "$e" && return 0
	done <<EOF
$2
EOF
	return 1
}

excerpt() { # file: failed test names, then the last 60 lines
	grep -Eo -- '--- FAIL: [^ ]+' "$1" | sort -u | head -n 20
	tail -n 60 "$1"
}

gate_name() { sed -n '1s/^gate: //p' "$TD/verify.txt"; }
# gate_fail NAME: message on stdin. It runs in a pipeline subshell, so callers read the name back with gate_name.
gate_fail() {
	{
		echo "gate: $1"
		head -n 80 # up to 20 failed test names plus 60 lines of output
	} >"$TD/verify.txt"
	return 1
}

gate_clean() {
	[ -z "$(git -C "$WT" status --porcelain)" ] || { git -C "$WT" status --short | gate_fail clean; return 1; }
	[ "$(git -C "$WT" rev-parse HEAD)" != "$BASE" ] || { echo "no commit beyond the base $BASE" | gate_fail clean; return 1; }
	return 0
}

gate_paths() {
	local s p bad=""
	while IFS=$'\t' read -r s p; do
		[ -z "$p" ] && continue
		in_list "$p" "$T_ALLOW" && continue
		if is_protected "$p"; then
			bad="$bad
protected path changed: $p"
		elif [ "$p" = go.mod ] || [ "$p" = go.sum ]; then
			bad="$bad
$p changed but the ticket does not allow it"
		elif [ "$p" = testdata/tests.txt ] || { [ -n "$T_SPEC" ] && [ "$p" = "$T_SPEC" ]; } || in_list "$p" "$T_PACKAGES"; then
			:
		else
			bad="$bad
outside the ticket's packages: $p"
		fi
	done < <(changed)
	[ -z "$bad" ] || { printf '%s\n' "${bad#?}" | gate_fail paths; return 1; }
}

gate_size() {
	local n
	n=$(git -C "$WT" diff "${GD[@]}" --no-renames --numstat "$BASE" HEAD | awk '
		$3 ~ /_test\.go$/ || $3 ~ /\.pb\.go$/ || $3 ~ /(^|\/)testdata\// || $3 == "go.sum" { next }
		$1 != "-" { n += $1 + $2 } END { print n + 0 }')
	[ "$n" -lt "$MAX_NEW_LINES" ] || { echo "non-test diff is $n lines; the limit is under $MAX_NEW_LINES. Split the ticket." | gate_fail size; return 1; }
}

gate_words() {
	local hits
	hits=$(git -C "$WT" diff "${GD[@]}" --no-renames -U0 --no-color "$BASE" HEAD | awk '
		/^\+\+\+ / { file = substr($2, 3); next }
		/^\+/ && file !~ /\.md$/ && tolower($0) ~ /(^|[^a-z])(todo|fixme|fallback|legacy)([^a-z]|$)/ { print file ": " substr($0, 2) }')
	[ -z "$hits" ] || { printf 'TODO, FIXME, fallback and legacy are not allowed in added lines:\n%s\n' "$hits" | gate_fail words; return 1; }
}

gate_tests_immutable() {
	local s p bad="" d f h
	if [ "$(git -C "$WT" diff "${GD[@]}" --no-renames --numstat "$BASE" HEAD -- testdata/tests.txt | awk '{ n += $2 } END { print n + 0 }')" -gt 0 ]; then
		bad="$bad
removed lines in testdata/tests.txt"
	fi
	h=$(git -C "$WT" diff "${GD[@]}" --no-renames -U0 --no-color "$BASE" HEAD -- '*_test.go' | awk '
		/^\+\+\+ / { file = substr($2, 3); next }
		/^\+[[:space:]]*\/\/[[:space:]]*(go:build|\+build)/ { print "added build constraint in " file ": " substr($0, 2) }
		/^\+[[:space:]]*[A-Za-z_.]*\.Skip(f|Now)?\(/ { print "added Skip in " file ": " substr($0, 2) }
		/^\+func TestMain\(/ { print "added TestMain in " file }')
	[ -z "$h" ] || bad="$bad
$h"
	while IFS=$'\t' read -r s p; do
		case "$p" in *_test.go) ;; *) continue ;; esac
		[ "$s" = A ] && continue
		if [ "$s" = D ]; then
			bad="$bad
deleted test file: $p"
		elif git -C "$WT" diff "${GD[@]}" --no-renames -U0 "$BASE" HEAD -- "$p" | grep -Eq '^-[^-]'; then
			bad="$bad
changed or removed lines in existing test file: $p"
		fi
	done < <(changed)
	if [ -f "$TD/locked.txt" ]; then
		while read -r h f; do
			[ -n "$f" ] || continue
			if [ ! -f "$WT/$f" ]; then
				bad="$bad
locked file missing: $f"
			elif [ "$(shasum -a 256 "$WT/$f" | awk '{print $1}')" != "$h" ]; then
				bad="$bad
locked file changed: $f"
			fi
		done <"$TD/locked.txt"
	fi
	[ -z "$bad" ] || { printf '%s\n' "${bad#?}" | gate_fail tests-immutable; return 1; }
}

gate_named() {
	[ -z "$T_TESTS" ] && return 0
	local pkg names re n out bad=""
	for pkg in $(printf '%s\n' "$T_TESTS" | awk '{print $1}' | sort -u); do
		names=$(printf '%s\n' "$T_TESTS" | awk -v p="$pkg" '$1 == p { print $2 }')
		re=$(printf '%s\n' "$names" | paste -sd '|' -)
		out=$TD/named.json
		(cd "$WT" && with_timeout "$SECS_GO" "${ENVP[@]}" go test -count=1 -json -run "^($re)\$" "$pkg") >"$out" 2>&1
		for n in $names; do
			if jq -Rse --arg n "$n" '[split("\n")[] | fromjson? | select(.Test != null and (.Test == $n or (.Test | startswith($n + "/"))) and .Action == "skip")] | length > 0' "$out" >/dev/null 2>&1; then
				bad="$bad
named test skipped: $pkg $n"
			elif ! jq -Rse --arg n "$n" '[split("\n")[] | fromjson? | select(.Test == $n and .Action == "pass")] | length > 0' "$out" >/dev/null 2>&1; then
				bad="$bad
named test did not pass: $pkg $n"
			fi
		done
	done
	[ -z "$bad" ] || { { printf '%s\n' "${bad#?}"; grep -Eo -- '--- FAIL: [^ ]+' "$out" | sort -u; } | gate_fail named-tests; return 1; }
}

# new_tests prints "dir TestName" for every Test or Fuzz function added in a _test.go file.
new_tests() {
	git -C "$WT" diff "${GD[@]}" --no-renames -U0 --no-color "$BASE" HEAD -- '*_test.go' | awk '
		/^\+\+\+ / { file = substr($2, 3); dir = file; sub(/\/?[^\/]*$/, "", dir); if (dir == "") dir = "."; next }
		/^\+func (Test|Fuzz)[A-Za-z0-9_]*\(/ { name = substr($0, 7); sub(/\(.*/, "", name); print dir, name }'
}

gate_red() {
	local nt dirs d re n bw out rc bad=""
	nt=$(new_tests)
	if [ -z "$nt" ]; then
		[ "$T_LEVEL" = light ] && return 0
		echo "no new Test or Fuzz functions: write the failing test first" | gate_fail new-tests-red
		return 1
	fi
	bw=$TD/basewt
	git -C "$ROOT" worktree remove --force "$bw" >/dev/null 2>&1
	git -C "$ROOT" worktree add --detach "$bw" "$BASE" >/dev/null 2>&1 || { echo "cannot create base worktree at $bw" | gate_fail new-tests-red; return 1; }
	local s p
	while IFS=$'\t' read -r s p; do
		[ "$s" = D ] && continue
		case "$p" in testdata/tests.txt) continue ;; *_test.go | testdata/* | */testdata/*) ;; *) continue ;; esac
		mkdir -p "$bw/$(dirname "$p")" && cp "$WT/$p" "$bw/$p"
	done < <(changed)
	dirs=$(printf '%s\n' "$nt" | awk '{print $1}' | sort -u)
	for d in $dirs; do
		re=$(printf '%s\n' "$nt" | awk -v d="$d" '$1 == d { print $2 }' | paste -sd '|' -)
		out=$TD/red.json
		(cd "$bw" && with_timeout "$SECS_GO" "${ENVP[@]}" go test -count=1 -json -run "^($re)\$" "./$d") >"$out" 2>&1
		rc=$?
		if [ $rc -eq 0 ]; then
			bad="$bad
new tests pass on the base commit in ./$d: $re"
			continue
		fi
		# With no test events the package failed to build, which counts as red.
		if jq -Rse '[split("\n")[] | fromjson? | select(.Test != null)] | length > 0' "$out" >/dev/null 2>&1; then
			for n in $(printf '%s\n' "$nt" | awk -v d="$d" '$1 == d { print $2 }'); do
				jq -Rse --arg n "$n" '[split("\n")[] | fromjson? | select(.Test == $n and .Action == "fail")] | length > 0' "$out" >/dev/null 2>&1 ||
					bad="$bad
new test did not fail on the base commit: ./$d $n"
			done
		fi
	done
	git -C "$ROOT" worktree remove --force "$bw" >/dev/null 2>&1
	[ -z "$bad" ] || { printf '%s\n' "${bad#?}" | gate_fail new-tests-red; return 1; }
}

gate_ci() {
	local rc
	(cd "$WT" && with_timeout "$SECS_CI" "${ENVP[@]}" bash -c "$CI_CMD") >"$TD/ci.log" 2>&1
	rc=$?
	[ $rc -eq 0 ] || { excerpt "$TD/ci.log" | gate_fail ci; return 1; }
}

# run_verify: all gates, cheap first; sets state verified or verify_failed.
run_verify() {
	local g
	: >"$TD/verify.txt"
	for g in clean paths size words tests_immutable named red ci; do
		log "gate $g"
		if ! "gate_$g"; then
			set_result verify_failed true "gate $(gate_name) failed; see .ticket/$ID/verify.txt"
			return 1
		fi
	done
	echo "all gates passed at $(git -C "$WT" rev-parse HEAD)" >"$TD/verify.txt"
	set_result verified false "all gates passed"
	return 0
}

# ---------------------------------------------------------------- stages

preflight() { # prints missing tools
	local missing="" t
	for t in git jq perl shasum awk "$CLAUDE_BIN" gh; do
		command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
	done
	case "$CI_CMD" in "make ci") command -v golangci-lint >/dev/null 2>&1 || missing="$missing golangci-lint" ;; esac
	[ -f "$ROOT/schemas/plan.json" ] && [ -f "$ROOT/schemas/review.json" ] && [ -f "$ROOT/schemas/impl.json" ] || missing="$missing schemas/*.json"
	[ -f "$ROOT/.claude/settings.json" ] || missing="$missing .claude/settings.json"
	printf '%s' "${missing# }"
}

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-$//'; }

cmd_start() {
	[ ! -f "$TD/state.json" ] || die "ticket $ID already started; use 'reset $ID --yes' to discard it"
	load_ticket "$ROOT/docs/tickets/$ID.md"
	local base branch
	base=$(git -C "$ROOT" rev-parse --verify "$BASE_BRANCH^{commit}" 2>/dev/null) || die "base branch $BASE_BRANCH not found"
	branch="t/$ID-$(slugify "$T_TITLE")"
	BASE=$base
	WT="$ROOT.worktrees/$ID"
	mkdir -p "$TD"
	cp "$ROOT/docs/tickets/$ID.md" "$TD/ticket.md"
	git -C "$ROOT" worktree add -b "$branch" "$WT" "$base" >"$TD/harness.log" 2>&1 || die "cannot create worktree $WT on $branch; see .ticket/$ID/harness.log"
	jq -n --arg id "$ID" --arg level "$T_LEVEL" --arg base "$base" --arg branch "$branch" --arg wt "$WT" \
		'{id: $id, level: $level, base: $base, branch: $branch, worktree: $wt, fix_rounds: 0}' >"$TD/state.json"
	set_result started false "worktree $WT on $branch from $base"
}

# dep_name DEPENDENCY: the module path, without a version ("example.com/m v1.2.3" and "example.com/m@v1.2.3" both give example.com/m).
dep_name() { printf '%s' "$1" | awk '{print $1}' | sed 's/@.*//'; }

# adr_names DEP: succeeds when an accepted ADR at the base commit (status line "- Status: accepted" or "- **Status:** Accepted")
# names the module DEP in full (not a prefix, not on a line or under a heading that says "rejected", subheadings included). Only modules with a dot in the first path element can be named.
adr_names() {
	local d=$1 f re
	case "${d%%/*}" in *.*) ;; *) return 1 ;; esac
	re=$(printf '%s' "$d" | sed 's/[.[\*^$+?(){}|]/\\&/g')
	re="(^|[^A-Za-z0-9._/-])$re(\$|[^A-Za-z0-9_/.-]|\.(\$|[^A-Za-z0-9]))"
	while IFS= read -r f; do
		git -C "$WT" show "$BASE:$f" 2>/dev/null | awk '
			/^[-*] +[*_]*Status[*_]*:[*_]* *[Aa]ccepted([^A-Za-z]|$)/ { ok = 1 }
			/^#/ {
				n = match($0, /[^#]/); n = n ? n - 1 : length($0)
				if (!skip || n <= lvl) { skip = ($0 ~ /[Rr]ejected/); lvl = n }
			}
			!skip && !/[Rr]ejected/ { body = body $0 "\n" }
			END { if (ok) printf "%s", body }' | grep -qE -- "$re" && return 0
	done < <(git -C "$WT" ls-tree --name-only "$BASE" docs/adr/ 2>/dev/null | grep '\.md$')
	return 1
}

# dep_authorized DEPENDENCY: named in the ticket's `dependencies` list, or by an accepted ADR as of the base commit.
dep_authorized() {
	local d e f
	d=$(dep_name "$1")
	[ -n "$d" ] || return 1
	while IFS= read -r e; do
		[ -n "$e" ] && [ "$(dep_name "$e")" = "$d" ] && return 0
	done <<EOF
$T_DEPS
EOF
	adr_names "$d"
}

unauthorized_deps() { # the plan's new dependencies that dep_authorized rejects, one per line
	local d
	while IFS= read -r d; do
		dep_authorized "$d" || printf '%s\n' "$d"
	done < <(jq -r '.new_dependencies[]' "$TD/plan.json")
}

# dep_spec ENTRY: prints "module@version" for go get, from "module v1.2.3" or "module@v1.2.3". Fails when there is no usable version.
dep_spec() {
	local m v extra
	read -r m v extra <<<"${1/@/ }"
	# A full semantic version only: v1, v1.2 and v2dev are queries that resolve to whatever is newest. A path with '..' could be a package pattern.
	local sv='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$'
	[[ $m =~ ^[A-Za-z0-9][A-Za-z0-9._~/-]*$ && $m != *..* && $v =~ $sv && -z $extra ]] || return 1
	printf '%s@%s' "$m" "$v"
}

# parse_deps: DEP_SPECS gets one "module@version" per entry of the ticket's `dependencies`. Fails with R_REASON when an entry has no version.
DEP_SPECS=()
parse_deps() {
	local e s bad=""
	DEP_SPECS=()
	while IFS= read -r e; do
		[ -n "$e" ] || continue
		if s=$(dep_spec "$e"); then DEP_SPECS+=("$s"); else bad="$bad '$e'"; fi
	done <<EOF
$T_DEPS
EOF
	[ -z "$bad" ] || { R_REASON="every dependency needs a version, 'module/path v1.2.3' or 'module/path@v1.2.3':$bad"; return 1; }
}

# go_ver_norm V: prints a three-part version (1.21 -> 1.21.0) from "go1.26.2", "1.27.0" or "1.21".
go_ver_norm() {
	local v=${1#go}
	case $v in
	*.*.*) printf '%s' "$v" ;;
	*.*) printf '%s.0' "$v" ;;
	*) printf '%s.0.0' "$v" ;;
	esac
}

# go_ver_ge A B: succeeds when version A is greater than or equal to version B.
go_ver_ge() {
	local a b
	a=$(go_ver_norm "$1")
	b=$(go_ver_norm "$2")
	[ "$a" = "$b" ] && return 0
	[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | head -1)" = "$b" ]
}

# go_fetch_toolchain: GOTOOLCHAIN for this worktree.
# Use local when the installed go already meets go.mod's `go` line (test fixtures, and machines whose /usr/local/go is new enough).
# Otherwise use the declared `toolchain` line (go1.27.4 in this repo) so fetch does not stall on an older local go.
# Last resort is a toolchain named from the `go` line. A listed module still cannot raise the go or toolchain lines:
# fetch_deps snapshots them and fails if they change.
go_fetch_toolchain() {
	local go_line tc localv
	go_line=$(awk '/^go / { print $2; exit }' "$WT/go.mod")
	tc=$(awk '/^toolchain / { print $2; exit }' "$WT/go.mod")
	# go env in the worktree would itself fail when local go is older than go.mod, so run outside any module.
	localv=$(cd / && "${ENVB[@]}" GOTOOLCHAIN=local go env GOVERSION 2>/dev/null) || localv=""
	if [ -n "$go_line" ] && [ -n "$localv" ] && go_ver_ge "$localv" "$go_line"; then
		printf 'local'
	elif [ -n "$tc" ]; then
		printf '%s' "$tc"
	elif [ -n "$go_line" ]; then
		printf 'go%s' "$(go_ver_norm "$go_line")"
	else
		printf 'local'
	fi
}

# go_fetch ARGS: runs go in the worktree with the caller's network settings and without GOFLAGS=-mod=readonly.
# GOTOOLCHAIN is go_fetch_toolchain, not a hard-coded local, so a machine whose installed go is older than go.mod
# still uses the already-declared toolchain (go1.27.4 here). A listed module cannot switch toolchains or raise the go line.
# FETCH_PROXY, when set, replaces the caller's GOPROXY for that call.
go_fetch_env() {
	local v
	GO_FETCH_ENV=("${ENVB[@]}")
	for v in $GO_FETCH_VARS; do [ -z "${!v+x}" ] || GO_FETCH_ENV+=("$v=${!v}"); done
	GO_FETCH_ENV+=("GOTOOLCHAIN=$(go_fetch_toolchain)")
	[ -z "${FETCH_PROXY:-}" ] || GO_FETCH_ENV+=("GOPROXY=$FETCH_PROXY")
}

go_fetch() {
	local GO_FETCH_ENV
	go_fetch_env
	(cd "$WT" && with_timeout "$SECS_GO" "${GO_FETCH_ENV[@]}" go "$@") >>"$TD/deps.log" 2>&1
}

# go_fetch_capture FILE ARGS: like go_fetch, but writes stdout to FILE (stderr still goes to deps.log).
go_fetch_capture() {
	local dest=$1 GO_FETCH_ENV
	shift
	go_fetch_env
	(cd "$WT" && with_timeout "$SECS_GO" "${GO_FETCH_ENV[@]}" go "$@") >"$dest" 2>>"$TD/deps.log"
}

# Temporary package that imports fetched modules so tidy records their transitive go.sum entries.
# Directories starting with . or _ are ignored by go list, so this cannot live under a hidden path.
FETCH_STUB_DIR=ticketfetchdeps

# fetch_pkg MODULE: a package path under MODULE that exists after go get (the module root, or the first package under it).
fetch_pkg() {
	local m=$1 out dest
	dest=$(mktemp "${TMPDIR:-/tmp}/fetch-pkg.XXXXXX") || return 1
	if go_fetch_capture "$dest" list -e -f '{{if not .Error}}{{.ImportPath}}{{end}}' "$m"; then
		out=$(tr -d '\r' <"$dest")
		rm -f "$dest"
		if [ -n "$out" ]; then printf '%s' "$out"; return 0; fi
	else
		rm -f "$dest"
	fi
	dest=$(mktemp "${TMPDIR:-/tmp}/fetch-pkg.XXXXXX") || return 1
	if go_fetch_capture "$dest" list -e -f '{{if not .Error}}{{.ImportPath}}{{end}}' "$m/..."; then
		out=$(awk 'NF { print; exit }' "$dest")
		rm -f "$dest"
		if [ -n "$out" ]; then printf '%s' "$out"; return 0; fi
	else
		rm -f "$dest"
	fi
	return 1
}

write_fetch_stub() {
	local s m p imports=""
	mkdir -p "$WT/$FETCH_STUB_DIR"
	for s in "${DEP_SPECS[@]}"; do
		m=${s%@*}
		p=$(fetch_pkg "$m") || { R_REASON="could not list a package under $m after go get; see .ticket/$ID/deps.log"; return 1; }
		imports="${imports}	_ \"$p\"
"
	done
	cat >"$WT/$FETCH_STUB_DIR/stub.go" <<EOF
package ticketfetchdeps

import (
$imports)
EOF
}

rm_fetch_stub() { rm -rf "$WT/$FETCH_STUB_DIR"; }

# fetch_deps: the harness, not the model, adds the ticket's `dependencies` to go.mod and go.sum before the impl session. Nothing is committed.
# After go get, a temporary package imports the listed modules so go mod tidy fills transitive go.sum entries that lazy
# loading would otherwise omit (an impl session under GOFLAGS=-mod=readonly cannot add them). The stub is then deleted
# and go get is run again; tidy is not run after the stub is gone, or those transitives would be pruned.
# tidy drops a module that nothing imports yet, so the second go get puts it back for the session to use.
# Tidy runs offline, after go mod download has cached the modules already required: it can resolve what the listed modules bring and nothing else.
# An import of a module that is not listed (and not already in go.mod) fails there instead of being looked up at latest.
# go and toolchain lines are snapshotted and must not change (a listed module must not bump the language version).
fetch_deps() {
	[ -n "$T_DEPS" ] || return 0
	parse_deps || return 1
	in_list go.mod "$T_ALLOW" && in_list go.sum "$T_ALLOW" || { R_REASON="a ticket with dependencies must list go.mod and go.sum in allow, or verify rejects the change"; return 1; }
	: >"$TD/deps.log"
	log "fetch ${DEP_SPECS[*]} (GOTOOLCHAIN=$(go_fetch_toolchain))"
	local go_lines
	go_lines=$(grep -E '^(go|toolchain) ' "$WT/go.mod" || true)
	rm_fetch_stub
	if ! { go_fetch get "${DEP_SPECS[@]}" && write_fetch_stub && go_fetch list "./$FETCH_STUB_DIR" && go_fetch mod download && FETCH_PROXY=off go_fetch mod tidy && rm_fetch_stub && go_fetch get "${DEP_SPECS[@]}"; }; then
		rm_fetch_stub
		R_REASON="go get or go mod tidy failed for ${DEP_SPECS[*]} (a module that is imported but not in the ticket's dependencies cannot be fetched); no model session was started; see .ticket/$ID/deps.log: $(tail -n 3 "$TD/deps.log" | tr '\n' ' ' | cut -c1-300)"
		return 1
	fi
	if [ "$(grep -E '^(go|toolchain) ' "$WT/go.mod" || true)" != "$go_lines" ]; then
		rm_fetch_stub
		R_REASON="fetch changed go.mod's go or toolchain line for ${DEP_SPECS[*]}; no model session was started; see .ticket/$ID/deps.log"
		return 1
	fi
}

cmd_tests() {
	require_state started plan_blocked
	[ "$T_LEVEL" = core ] || die "only core tickets have a tests stage"
	local n
	prompt_plan
	claude_call plan sonnet medium "$BUDGET_PLAN" plan plan || { set_result plan_blocked true "$R_REASON"; return; }
	jq -e 'has("tests") and has("ambiguities") and has("contract_change_required") and has("new_dependencies")' "$TD/plan.json" >/dev/null || { set_result plan_blocked true "plan.json is missing required fields"; return; }
	local deps
	deps=$(unauthorized_deps)
	if jq -e '.contract_change_required or ([.ambiguities[] | select(.blocking)] | length > 0)' "$TD/plan.json" >/dev/null || [ -n "$deps" ]; then
		set_result plan_blocked true "plan needs a decision (contract change, new dependency or blocking question)${deps:+; new dependency not in an accepted ADR or the ticket: $(printf '%s' "$deps" | tr '\n' ' ')}; see .ticket/$ID/plan.json"
		return
	fi
	prompt_tests
	claude_call tests sonnet medium "$BUDGET_TESTS" impl write || { set_result plan_blocked true "$R_REASON"; return; }
	if [ "$(jq -r .status "$TD/tests.json")" != done ]; then
		set_result plan_blocked true "tests stage blocked: $(jq -r .blocked_reason "$TD/tests.json" | cut -c1-300)"
		return
	fi
	[ -z "$(git -C "$WT" status --porcelain)" ] && [ "$(git -C "$WT" rev-parse HEAD)" != "$BASE" ] || { set_result plan_blocked true "tests stage left the tree dirty or made no commit"; return; }
	local p bad=""
	while IFS=$'\t' read -r _ p; do
		case "$p" in *_test.go | testdata/*) ;; *) bad="$bad $p" ;; esac
	done < <(changed)
	[ -z "$bad" ] || { set_result plan_blocked true "tests stage changed non-test files:$bad"; return; }
	if ! gate_red; then
		set_result plan_blocked true "gate $(gate_name) failed; see .ticket/$ID/verify.txt"
		return
	fi
	git -C "$WT" diff "${GD[@]}" --no-renames --name-only "$BASE" HEAD | grep -v '^testdata/tests.txt$' | while IFS= read -r n; do
		printf '%s  %s\n' "$(shasum -a 256 "$WT/$n" | awk '{print $1}')" "$n"
	done >"$TD/locked.txt"
	set_result tests_ready true "approve the tests (see 'git -C $WT show HEAD'), then: scripts/ticket impl $ID"
}

cmd_impl() {
	require_state started tests_ready impl_blocked verify_failed
	local attempt failure=""
	fetch_deps || { set_result impl_blocked true "$R_REASON"; return; }
	for attempt in 1 2; do
		prompt_impl "$failure"
		if ! claude_call impl "$IMPL_MODEL" medium "$BUDGET_IMPL" impl write; then
			set_result impl_blocked true "$R_REASON"
			return
		fi
		if [ "$(jq -r .status "$TD/impl.json")" != done ] || [ "$(jq -r .contract_change_needed "$TD/impl.json")" = true ]; then
			set_result impl_blocked true "implementer stopped: $(jq -r '.blocked_reason' "$TD/impl.json" | cut -c1-300)"
			return
		fi
		run_verify && return
		failure=$(cat "$TD/verify.txt")
		log "impl attempt $attempt failed verify"
	done
}

cmd_verify() {
	[ -d "$WT" ] || die "worktree $WT is missing"
	run_verify
}

pr_body() {
	local core=no p
	while IFS=$'\t' read -r _ p; do is_trusted_core "$p" && core="yes: $p, ..."; done < <(changed)
	cat <<EOF
## Ticket

$ID: $T_TITLE ($T_LEVEL)

## What changed

\`\`\`
$(git -C "$WT" diff --no-renames --stat "$BASE" HEAD | tail -n 30)
\`\`\`

## Evidence

Harness verify: $(head -n 1 "$TD/verify.txt")
\`$CI_CMD\` passed in a fresh run. Failed tests were red on the base commit; named tests pass and are not skipped.

## Tests added or changed, with a reason for any removed

$(new_tests | awk '{print "- " $1 " " $2}')
No existing test lines were changed or deleted (gate: tests-immutable).

## Security notes

Diff stayed inside the ticket's packages; no protected path or go.mod change.

## Trusted core touched

$core
EOF
}

cmd_pr() {
	require_state verified pr_blocked
	local url
	git -C "$WT" -c core.hooksPath=/dev/null push --no-verify -u origin "$(st_get branch)" >>"$TD/harness.log" 2>&1 || { set_result pr_blocked true "git push failed; see .ticket/$ID/harness.log"; return; }
	pr_body >"$TD/pr-body.md"
	url=$(cd "$WT" && gh pr create --base "$BASE_BRANCH" --head "$(st_get branch)" --title "$ID: $T_TITLE" --body-file "$TD/pr-body.md" 2>>"$TD/harness.log") || { set_result pr_blocked true "gh pr create failed; see .ticket/$ID/harness.log"; return; }
	st_set pr "$url"
	set_result pr_open false "$url"
}

review_markdown() {
	jq -r '"## Review (" + .verdict + ")\n\nChecked: " + (.checked | join("; ")) + "\n\n" +
		(if (.findings | length) == 0 then "No findings.\n" else
		([.findings[] | "- **" + .severity + "** " + .category + " `" + .file + ":" + (.line | tostring) + "`: " + .what_breaks + "\n  - Scenario: " + .failing_scenario + "\n  - Test: " + .suggested_test] | join("\n")) end)' "$TD/review.json"
}

cmd_review() {
	require_state pr_open review_blocked
	[ -n "$REVIEW_MODEL" ] || die "light tickets have no review stage"
	prompt_review
	claude_call review "$REVIEW_MODEL" high "$BUDGET_REVIEW" review review || { set_result review_blocked true "$R_REASON"; return; }
	jq -e '.verdict and (.findings | type == "array")' "$TD/review.json" >/dev/null || { set_result review_blocked true "review.json is malformed"; return; }
	review_markdown >"$TD/review.md"
	(cd "$WT" && gh pr comment "$(st_get pr)" --body-file "$TD/review.md") >>"$TD/harness.log" 2>&1 || log "could not post the review to the PR; it is in review.md"
	if jq -e '[.findings[] | select(.severity == "blocker" or .severity == "major")] | length > 0' "$TD/review.json" >/dev/null; then
		set_result review_findings false "$(jq '[.findings[] | select(.severity == "blocker" or .severity == "major")] | length' "$TD/review.json") blocker/major findings; next: fix"
	else
		set_result reviewed false "no blocker or major findings"
	fi
}

cmd_fix() {
	require_state review_findings
	[ "$(st_get fix_rounds)" = 0 ] || { set_result fix_failed true "the one fix round is used up; see .ticket/$ID/review.md"; return; }
	st_setj fix_rounds 1
	prompt_fix
	claude_call fix "$IMPL_MODEL" medium "$BUDGET_FIX" impl write || { set_result fix_failed true "$R_REASON"; return; }
	if [ "$(jq -r .status "$TD/fix.json")" != done ]; then
		set_result fix_failed true "fix stopped: $(jq -r '.blocked_reason' "$TD/fix.json" | cut -c1-300)"
		return
	fi
	if ! run_verify; then
		set_result fix_failed true "$R_REASON after the fix round"
		return
	fi
	git -C "$WT" -c core.hooksPath=/dev/null push --no-verify >>"$TD/harness.log" 2>&1 || { set_result fix_failed true "git push failed; see .ticket/$ID/harness.log"; return; }
	set_result ready true "fix round applied and verified: owner re-reads the findings in .ticket/$ID/review.md, then merges $(st_get pr)"
}

mark_ready() {
	case "$T_LEVEL" in
	core) set_result ready true "owner reviews every line, then squash-merges $(st_get pr)" ;;
	standard) set_result ready true "merge $(st_get pr) once GitHub CI is green" ;;
	light) set_result ready true "add $(st_get pr) to the merge batch" ;;
	esac
}

cmd_status() {
	R_STATE=$(st_get state)
	R_NH=$(st_get needs_human)
	R_NH=${R_NH:-false}
	R_REASON=$(st_get reason)
}

cmd_reset() {
	if [ "$YES" != 1 ]; then
		set_result "$(st_get state)" true "reset discards the worktree, branch and .ticket/$ID; run again with --yes"
		return
	fi
	local branch
	branch=$(st_get branch)
	case "$branch" in
	"t/$ID" | "t/$ID-"*) ;;
	*) [ -z "$branch" ] || die "state.json branch '$branch' does not match t/$ID*; not deleting it" ;;
	esac
	git -C "$ROOT" worktree remove --force "$WT" >/dev/null 2>&1
	git -C "$ROOT" worktree remove --force "$TD/basewt" >/dev/null 2>&1
	[ -n "$branch" ] && git -C "$ROOT" branch -D "$branch" >/dev/null 2>&1
	rm -rf "$TD"
	R_STATE=reset R_NH=false R_REASON="worktree, branch and .ticket/$ID removed"
}

cmd_run() {
	local state guard=0
	while [ $guard -lt 12 ]; do
		guard=$((guard + 1))
		[ -f "$TD/state.json" ] && state=$(st_get state) || state=new
		case "$state" in
		new) cmd_start ;;
		started) if [ "$T_LEVEL" = core ]; then cmd_tests; else cmd_impl; fi ;;
		tests_ready)
			if [ "$APPROVE" = 1 ]; then cmd_impl; else
				cmd_status
				return
			fi
			;;
		verified) cmd_pr ;;
		pr_open) if [ -n "$REVIEW_MODEL" ]; then cmd_review; else mark_ready; fi ;;
		review_findings) cmd_fix ;;
		reviewed) mark_ready ;;
		*)
			cmd_status
			return
			;;
		esac
		[ "$R_NH" = true ] && return
		[ "$R_STATE" = ready ] && return
	done
	die "run did not settle after $guard steps; see .ticket/$ID/harness.log"
}

describe_pipeline() {
	case "$T_LEVEL" in
	core) echo "core: tests(sonnet) -> owner approves tests -> impl(sonnet) -> verify -> pr -> review(opus) -> fix(sonnet, one round) -> owner merges" ;;
	standard) echo "standard: impl(sonnet) -> verify -> pr -> review(sonnet) -> fix(sonnet, one round) -> merge when CI is green" ;;
	light) echo "light: impl(sonnet) -> verify -> pr -> merge batch" ;;
	esac
}

cmd_dry_run() {
	load_ticket "$ROOT/docs/tickets/$ID.md"
	local missing p base n
	base=$(git -C "$ROOT" rev-parse --verify "$BASE_BRANCH^{commit}" 2>/dev/null) || die "base branch $BASE_BRANCH not found"
	for p in $T_SPEC $T_READS; do [ -e "$ROOT/$p" ] || die "ticket lists '$p' but it does not exist"; done
	parse_deps || die "$R_REASON"
	n=$(printf '%s\n' "$T_TESTS" | grep -c . || true)
	missing=$(preflight)
	if [ -n "$missing" ]; then
		R_STATE=dry_run R_NH=true R_REASON="missing before a real run: $missing. $(describe_pipeline)"
	else
		R_STATE=dry_run R_NH=false R_REASON="ready. $(describe_pipeline); branch t/$ID-$(slugify "$T_TITLE") from ${base:0:12}; $n named tests; verify runs '$CI_CMD'"
	fi
}

# ---------------------------------------------------------------- main

usage() {
	echo '{"id":"","state":"error","needs_human":true,"reason":"usage: scripts/ticket <start|tests|impl|verify|pr|review|fix|status|run|reset> <ID> [--approve] [--yes] [--dry-run]"}'
	exit 2
}

main() {
	[ $# -ge 2 ] || usage
	local cmd=$1
	ID=$2
	shift 2
	APPROVE=0 YES=0 DRY=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--approve) APPROVE=1 ;;
		--yes) YES=1 ;;
		--dry-run) DRY=1 ;;
		*) usage ;;
		esac
		shift
	done
	[[ "$ID" =~ ^[A-Z0-9]+-[0-9]+[a-z]?$ ]] || die "ticket id must look like W0-1, W12-3 or W0-0b"
	TD=$ROOT/.ticket/$ID
	WT=$ROOT.worktrees/$ID
	if [ "$DRY" = 1 ]; then
		[ "$cmd" = run ] || die "--dry-run works with 'run' only"
		cmd_dry_run
		emit
		[ "$R_NH" = true ] && exit 1
		exit 0
	fi
	if [ "$cmd" != start ] && [ "$cmd" != run ]; then
		[ -f "$TD/state.json" ] || die "ticket $ID has not been started; run: scripts/ticket start $ID"
	fi
	if [ -f "$TD/state.json" ]; then
		WT=$(st_get worktree)
		BASE=$(git -C "$WT" merge-base "$BASE_BRANCH" HEAD) || die "cannot find the merge base of $BASE_BRANCH and the worktree HEAD"
		load_ticket "$TD/ticket.md"
		models
	elif [ "$cmd" = run ]; then
		load_ticket "$ROOT/docs/tickets/$ID.md"
		models
	fi
	case "$cmd" in
	start) cmd_start ;;
	tests) cmd_tests ;;
	impl) cmd_impl ;;
	verify) cmd_verify ;;
	pr) cmd_pr ;;
	review) cmd_review ;;
	fix) cmd_fix ;;
	status) cmd_status ;;
	reset) cmd_reset ;;
	run) cmd_run ;;
	*) usage ;;
	esac
	emit
	[ "$R_NH" = true ] && exit 1
	exit 0
}

main "$@"
