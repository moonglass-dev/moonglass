#!/usr/bin/env bash
# Tests the ticket harness: one fake ticket that must pass verify, and fakes that must each fail one gate.
# Builds a throwaway repository and worktree under a temp directory. Needs git, go, jq and perl; no Claude calls.
set -u -o pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
TICKET=$HERE/ticket
SETTINGS=$HERE/../.claude/settings.json
TMP=$(mktemp -d "${TMPDIR:-/tmp}/ticket-test.XXXXXX") || exit 2
# The Go module cache is read-only.
trap 'chmod -R u+w "$TMP" 2>/dev/null; rm -rf "$TMP"' EXIT

export TICKET_ROOT=$TMP/repo
export TICKET_CI_CMD='go test ./...'
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
mkdir -p "$TICKET_ROOT" && cd "$TICKET_ROOT" || exit 2

git init -q -b main .
mkdir -p pkg/calc pkg/other docs/tickets
printf 'module example.com/fix\n\ngo 1.21\n' >go.mod
printf '.ticket/\n' >.gitignore
printf 'ci:\n\tgo test ./...\n' >Makefile
cat >pkg/calc/calc.go <<'EOF'
package calc

func Add(a, b int) int { return a + b }
EOF
cat >pkg/calc/calc_test.go <<'EOF'
package calc

import "testing"

func TestAdd(t *testing.T) {
	if got := Add(1, 2); got != 3 {
		t.Errorf("Add(1, 2): expected 3, got %d", got)
	}
}
EOF
mkdir -p testdata
printf './pkg/calc TestAdd\n' >testdata/tests.txt
cat >pkg/other/other.go <<'EOF'
package other
EOF
cat >docs/tickets/FAKE-1.md <<'EOF'
---
id: FAKE-1
level: standard
packages:
  - pkg/calc
tests:
  - ./pkg/calc TestMul
---

# Multiply two numbers
EOF
# Settings, schemas and ADRs that the session-settings and plan-stage checks read from the worktree.
mkdir -p .claude schemas docs/adr
cp "$SETTINGS" .claude/settings.json
cp "$HERE"/../schemas/*.json schemas/
printf '# ADR 1\n\n- Status: accepted\n\nUses example.com/adr-named and example.com/adr-named-extra.\nRejected: example.com/rejected\n\n## Alternatives rejected\n\n- example.com/rejected-section\n\n### example.com/rejected-sub\n\nMore under the rejected section.\n\n### example.com/sub-heading\n\nBody names example.com/sub-body.\n\n## Links\n\n- adr\n' >docs/adr/0001-fake.md
printf '# ADR 2\n\n- Status: proposed\n\nMay use example.com/proposed-only.\n' >docs/adr/0002-fake.md
# The repo's ADRs write the status as "- **Status:** Accepted" (0001-0007) or "- Status: accepted" (0008).
printf '# ADR 3\n\n- **Status:** Accepted\n\nUses example.com/bold-accepted.\n\n## Alternatives rejected\n\n### example.com/bold-rejected-sub\n\n## Links\n\n### example.com/bold-after-sub\n' >docs/adr/0003-fake.md
for st in Proposed Rejected Deprecated Superseded Superceded; do
	l=$(printf '%s' "$st" | tr 'A-Z' 'a-z')
	printf '# ADR\n\n- **Status:** %s\n\nUses example.com/bold-%s.\n' "$st" "$l" >"docs/adr/01$l-fake.md"
done
printf '# ADR\n\n- Status: rejected\n\nUses example.com/plain-rejected.\n' >docs/adr/0200-fake.md
# Fixtures whose module names do not contain "rejected", so only the status line can decide the result.
n=0
for st in Proposed Rejected Deprecated Superseded Superceded; do
	n=$((n + 1))
	printf '# ADR\n\n- **Status:** %s\n\nUses example.com/bold-st-%s.\n' "$st" "$n" >"docs/adr/03st$n-fake.md"
done
printf '# ADR\n\n- Status: rejected\n\nUses example.com/plain-st.\n' >docs/adr/0300-fake.md
printf '# ADR\n\n- **Status:** Accepted\n\nUses example.com/bold-st-ok.\n' >docs/adr/0301-fake.md
printf '# ADR\n\n- Status: accepted\n\nUses example.com/plain-st-ok.\n' >docs/adr/0302-fake.md
git add -A && git commit -q -m base

fail=0
check() { # name, jq expression that must be true on the verify output, output
	if printf '%s' "$3" | jq -e "$2" >/dev/null 2>&1; then
		echo "PASS $1"
	else
		echo "FAIL $1: $3"
		fail=1
	fi
}

out=$("$TICKET" start FAKE-1)
check "start" '.state == "started" and .needs_human == false' "$out"
WT=$TMP/repo.worktrees/FAKE-1
BASE=$(git -C "$WT" rev-parse HEAD)

commit() { git -C "$WT" add -A && git -C "$WT" commit -q -m "$1"; }
reset_wt() { git -C "$WT" reset -q --hard "$BASE" && git -C "$WT" clean -qfd; }

mul_impl() { printf '\nfunc Mul(a, b int) int { return a * b }\n' >>"$WT/pkg/calc/calc.go"; }
mul_test() { # body of TestMul
	printf '\nfunc TestMul(t *testing.T) {\n%s\n}\n' "$1" >>"$WT/pkg/calc/calc_test.go"
}
good_test='	if got := Mul(2, 3); got != 6 {
		t.Errorf("Mul(2, 3): expected 6, got %d", got)
	}'

expect_fail() { # name, gate
	out=$("$TICKET" verify FAKE-1)
	check "$1" ".state == \"verify_failed\" and .needs_human == true and (.reason | contains(\"gate $2 \"))" "$out"
}

# 1. A good change passes every gate, including red-on-base through a compile failure.
reset_wt
mul_impl
mul_test "$good_test"
commit good
out=$("$TICKET" verify FAKE-1)
check "good change passes verify" '.state == "verified" and .needs_human == false' "$out"

# 2. A skipped named test.
reset_wt
mul_impl
mul_test '	t.Skip("later")'
commit skipped
expect_fail "skipped test fails" tests-immutable

# 3. A weakened existing test.
reset_wt
mul_impl
mul_test "$good_test"
sed -i.bak 's/got != 3/got != 4 \&\& got != 3/' "$WT/pkg/calc/calc_test.go" && rm -f "$WT/pkg/calc/calc_test.go.bak"
commit weakened
expect_fail "weakened test fails" tests-immutable

# 4. A protected path.
reset_wt
mul_impl
mul_test "$good_test"
printf '\n# edit\n' >>"$WT/Makefile"
commit protected
expect_fail "protected-path edit fails" paths

# 5. A change outside the ticket's packages.
reset_wt
mul_impl
mul_test "$good_test"
printf '\nfunc Extra() {}\n' >>"$WT/pkg/other/other.go"
commit outside
expect_fail "out-of-package diff fails" paths

# 6. An oversized non-test diff.
reset_wt
mul_impl
mul_test "$good_test"
{
	printf 'package calc\n\n'
	i=0
	while [ $i -lt 850 ]; do
		printf 'var big%d = %d\n' "$i" "$i"
		i=$((i + 1))
	done
} >"$WT/pkg/calc/big.go"
commit oversized
expect_fail "oversized diff fails" size

# 6d. Generated *.pb.go does not count toward the size cap.
# *.pb.go is a protected path, so the ticket must allow it, as a real proto ticket does.
reset_wt
cp "$TICKET_ROOT/.ticket/FAKE-1/ticket.md" "$TMP/fake-1-ticket.md"
python3 -c '
from pathlib import Path
p = Path("'"$TICKET_ROOT"'/.ticket/FAKE-1/ticket.md")
t = p.read_text()
old = """packages:
  - pkg/calc
tests:
"""
new = """packages:
  - pkg/calc
allow:
  - pkg/calc/calc.pb.go
tests:
"""
if old not in t:
    raise SystemExit("FAKE-1 frontmatter not in expected shape")
p.write_text(t.replace(old, new, 1))
'
mul_impl
mul_test "$good_test"
{
	printf 'package calc\n\n'
	i=0
	while [ $i -lt 850 ]; do
		printf 'var gen%d = %d\n' "$i" "$i"
		i=$((i + 1))
	done
} >"$WT/pkg/calc/calc.pb.go"
commit generated-pbgo
out=$("$TICKET" verify FAKE-1)
check "generated .pb.go is excluded from the size cap" '.state == "verified" and .needs_human == false' "$out"
cp "$TMP/fake-1-ticket.md" "$TICKET_ROOT/.ticket/FAKE-1/ticket.md"

# 6a. A .gitattributes file is protected.
reset_wt
mul_impl
mul_test "$good_test"
printf '*.go diff=evil\n' >"$WT/pkg/calc/.gitattributes"
commit gitattributes
expect_fail ".gitattributes edit fails" paths

# 6b. Removing a line from testdata/tests.txt.
reset_wt
mul_impl
mul_test "$good_test"
: >"$WT/testdata/tests.txt"
commit tests-list-shrunk
expect_fail "removed tests.txt line fails" tests-immutable

# 6c. A build constraint added to a test file.
reset_wt
mul_impl
mul_test "$good_test"
printf '//go:build never\n\npackage calc\n' >"$WT/pkg/calc/extra_test.go"
commit build-constraint
expect_fail "added build constraint fails" tests-immutable

# 8. Ticket ids: an optional letter suffix is accepted; anything else is rejected.
for id in W0-0b W0-0c W0-6 W12-3; do
	sed "s/^id: FAKE-1/id: $id/" "$TICKET_ROOT/docs/tickets/FAKE-1.md" >"$TICKET_ROOT/docs/tickets/$id.md"
	out=$("$TICKET" run "$id" --dry-run)
	check "id $id is accepted" '.state == "dry_run"' "$out"
done
for id in W0-0bb W0-b W0-0B w0-6 W0; do
	out=$("$TICKET" status "$id" 2>/dev/null)
	check "id $id is rejected" '.state == "error" and (.reason | contains("ticket id must look like"))' "$out"
done

# 9. Plan stage and write-session settings, with a fake claude that records its --settings file.
cat >"$TMP/fake-claude" <<'EOF'
#!/usr/bin/env bash
# The scrubbed environment passes CLAUDE_* variables only. Plan calls (--tools Read,Grep,Glob) return $CLAUDE_FAKE_PLAN. Write calls save their --settings file and report blocked.
cat >/dev/null
settings="" plan=0 review=0
printf '%s\n' "$@" >"${CLAUDE_FAKE_ARGS:-/dev/null}"
while [ $# -gt 0 ]; do
	case "$1" in
	--settings) settings=$2; shift ;;
	--tools) [ "$2" = Read,Grep,Glob ] && plan=1; [ "$2" = Read,Grep,Glob,Bash ] && review=1; shift ;;
	esac
	shift
done
if [ $review = 1 ]; then
	echo '{"is_error":false,"total_cost_usd":0,"num_turns":1,"structured_output":{"verdict":"pass","checked":["fake"],"findings":[]}}'
elif [ $plan = 1 ]; then
	jq -c --slurpfile p "$CLAUDE_FAKE_PLAN" -n '{is_error: false, total_cost_usd: 0, num_turns: 1, structured_output: $p[0]}'
else
	cp "$settings" "$CLAUDE_FAKE_OUT"
	echo '{"is_error":false,"total_cost_usd":0,"num_turns":1,"structured_output":{"status":"blocked","blocked_reason":"fake stop","contract_change_needed":false}}'
fi
EOF
chmod +x "$TMP/fake-claude"
export CLAUDE_BIN=$TMP/fake-claude CLAUDE_FAKE_PLAN=$TMP/plan.json CLAUDE_FAKE_OUT=$TMP/session-settings.json

fake2() { # allow list lines for the frontmatter, written to the ticket copy and to docs/tickets
	cat <<EOF
---
id: FAKE-2
level: core
packages:
  - pkg/calc
tests:
  - ./pkg/calc TestMul
dependencies:
  - example.com/listed v1.0.0
$1
---

# Multiply with a dependency
EOF
}
ALLOW_ALL='allow:
  - Makefile
  - docs/adr
  - pkg/calc/calc.pb.go
  - proto/a.proto
  - .golangci.yml
  - .claude
  - .claude/settings.json
  - scripts/ticket'
fake2 "$ALLOW_ALL" >"$TICKET_ROOT/docs/tickets/FAKE-2.md"
out=$("$TICKET" start FAKE-2)
check "start FAKE-2" '.state == "started"' "$out"
WT2=$(cd "$TMP/repo.worktrees/FAKE-2" && pwd -P)
T2=$TICKET_ROOT/.ticket/FAKE-2/ticket.md

plan() { # new_dependencies JSON, contract_change_required, ambiguities JSON
	jq -nc --argjson d "$1" --argjson c "${2:-false}" --argjson a "${3:-[]}" \
		'{ticket: "FAKE-2", tests: [], files: [], signatures: [], ambiguities: $a, contract_change_required: $c, new_dependencies: $d}' >"$TMP/plan.json"
}
blocked_dep='.state == "plan_blocked" and (.reason | contains("new dependency not in an accepted ADR or the ticket"))'
past_plan='.state == "plan_blocked" and (.reason | contains("tests stage blocked"))'

plan '["example.com/unlisted"]'
check "unlisted dependency blocks the plan" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/proposed-only"]'
check "dependency in a proposed ADR still blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/adr-named v1.2.0", "example.com/unlisted"]'
check "one unauthorized dependency blocks the plan" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/adr-named"]' true
check "contract change still blocks" '.state == "plan_blocked" and (.reason | contains("plan needs a decision"))' "$("$TICKET" tests FAKE-2)"
plan '[]' false '[{"question":"q","blocking":true,"proposed_answer":"a"}]'
check "blocking ambiguity still blocks" '.state == "plan_blocked" and (.reason | contains("plan needs a decision"))' "$("$TICKET" tests FAKE-2)"

plan '["example.com/rejected"]'
check "dependency on a Rejected line of an accepted ADR blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/rejected-section"]'
check "dependency under Alternatives rejected blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/adr"]'
check "prefix of an ADR-named module blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["adr"]'
check "bare word in an accepted ADR blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/adr-named-extra"]'
check "full module name in an accepted ADR passes" "$past_plan" "$("$TICKET" tests FAKE-2)"

plan '["example.com/rejected-sub"]'
check "subheading under Alternatives rejected still blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/sub-heading"]'
check "subheading line under Alternatives rejected does not name a module" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/sub-body"]'
check "body under a subheading of Alternatives rejected does not name a module" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/bold-rejected-sub"]'
check "subheading under Alternatives rejected in a bold-status ADR blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/bold-accepted"]'
check "module in a '- **Status:** Accepted' ADR passes" "$past_plan" "$("$TICKET" tests FAKE-2)"
plan '["example.com/bold-after-sub"]'
check "heading after a rejected section ends the skip" "$past_plan" "$("$TICKET" tests FAKE-2)"
for l in proposed rejected deprecated superseded superceded; do
	plan "[\"example.com/bold-$l\"]"
	check "module in a '- **Status:** $l' ADR blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
done
plan '["example.com/plain-rejected"]'
check "module in a '- Status: rejected' ADR blocks" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
# Module names here do not contain "rejected", so only the status line decides.
for n in 1 2 3 4 5; do
	plan "[\"example.com/bold-st-$n\"]"
	check "status line alone blocks bold-status ADR $n" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
done
plan '["example.com/plain-st"]'
check "status line alone blocks a '- Status: rejected' ADR" "$blocked_dep" "$("$TICKET" tests FAKE-2)"
plan '["example.com/bold-st-ok"]'
check "same style of module under '- **Status:** Accepted' passes" "$past_plan" "$("$TICKET" tests FAKE-2)"
plan '["example.com/plain-st-ok"]'
check "same style of module under '- Status: accepted' passes" "$past_plan" "$("$TICKET" tests FAKE-2)"

rm -f "$CLAUDE_FAKE_OUT"
plan '["example.com/adr-named@v1.2.0", "example.com/listed"]'
check "dependency named by an accepted ADR or the ticket passes the plan" "$past_plan" "$("$TICKET" tests FAKE-2)"

# The write session ran with the ticket's allow list applied.
S=$(cat "$CLAUDE_FAKE_OUT" 2>/dev/null || echo '{}')
for pat in 'Makefile' 'docs/adr' '[.]pb[.]go' '[.]proto' 'golangci'; do
	check "allow lifts the $pat deny" "any(.permissions.deny[]; test(\"$pat\")) | not" "$S"
done
check "allowed session keeps .claude denied" "any(.permissions.deny[]; . == \"Edit(/$WT2/.claude/**)\")" "$S"
check "allowed session keeps scripts/ticket denied" "any(.permissions.deny[]; . == \"Edit(/$WT2/scripts/ticket)\")" "$S"
check "allowed session keeps unrelated denies" 'any(.permissions.deny[]; endswith("/AGENTS.md)")) and any(.permissions.deny[]; . == "Edit(../**)") and any(.permissions.deny[]; . == "Bash(git push *)")' "$S"
check "session settings root the allow rule at the worktree" "any(.permissions.allow[]; . == \"Edit(/$WT2/**)\")" "$S"

# Without an allow list nothing is lifted.
fake2 'allow: []' >"$T2"
rm -f "$CLAUDE_FAKE_OUT"
"$TICKET" tests FAKE-2 >/dev/null
S=$(cat "$CLAUDE_FAKE_OUT" 2>/dev/null || echo '{}')
check "no allow list keeps the Makefile deny" "any(.permissions.deny[]; . == \"Edit(/$WT2/Makefile)\")" "$S"
check "no allow list keeps the adr and pb.go denies" "any(.permissions.deny[]; . == \"Edit(/$WT2/docs/adr/**)\") and any(.permissions.deny[]; . == \"Edit(**/*.pb.go)\")" "$S"

# A ticket that only allows the guard gets no override for it.
fake2 'allow:
  - .claude
  - scripts/ticket' >"$T2"
rm -f "$CLAUDE_FAKE_OUT"
"$TICKET" tests FAKE-2 >/dev/null
S=$(cat "$CLAUDE_FAKE_OUT" 2>/dev/null || echo '{}')
check "allowing .claude and scripts/ticket lifts nothing" "any(.permissions.deny[]; . == \"Edit(/$WT2/.claude/**)\") and any(.permissions.deny[]; . == \"Edit(/$WT2/scripts/ticket)\") and (.permissions.deny | length) == ($(jq '.permissions.deny | length' "$SETTINGS"))" "$S"

# The review session has no code to run, so it must not inherit the inspection allows: Read denies do not stop cat.
mkdir -p "$TMP/bin"
printf '#!/bin/sh\nexit 1\n' >"$TMP/bin/gh"
chmod +x "$TMP/bin/gh"
jq '.state = "pr_open"' "$TICKET_ROOT/.ticket/FAKE-2/state.json" >"$TMP/state.json" && cp "$TMP/state.json" "$TICKET_ROOT/.ticket/FAKE-2/state.json"
export CLAUDE_FAKE_ARGS=$TMP/review-args.txt
PATH=$TMP/bin:$PATH "$TICKET" review FAKE-2 >/dev/null
A=$(jq -Rs 'split("\n")' "$CLAUDE_FAKE_ARGS")
for c in cat rg grep find head wc ls; do
	check "review disallows Bash($c)" "any(.[]; . == \"Bash($c:*)\")" "$A"
done
unset CLAUDE_BIN CLAUDE_FAKE_PLAN CLAUDE_FAKE_OUT CLAUDE_FAKE_ARGS

# 10. Read-only inspection is allowed, and the dangerous variants stay denied.
S=$(cat "$SETTINGS")
for c in 'ls' 'ls *' 'cat *' 'rg *' 'grep *' 'find *' 'head *' 'wc *' 'go list *' 'git show *'; do
	check "settings allow Bash($c)" "any(.permissions.allow[]; . == \"Bash($c)\")" "$S"
done
for c in 'find *-delete*' 'find *-exec*' 'find *-fprint*' 'rg *--pre*' 'go get *' 'go install *' 'go run *' 'go * -mod *' 'git push *'; do
	check "settings deny Bash($c)" "any(.permissions.deny[]; . == \"Bash($c)\")" "$S"
done
for c in '/.claude/**' '/scripts/ticket' '/Makefile' '/docs/adr/**' '**/*.proto' '**/*.pb.go' '/.golangci.yml'; do
	check "settings still deny Edit($c)" "any(.permissions.deny[]; . == \"Edit($c)\")" "$S"
done

# 11. Write sessions can commit, and format only through make fmt; the commit denies still hold.
for c in 'git add *' 'git commit -m *' 'git commit -q -m *' 'git commit -qm *' 'git commit --quiet -m *' 'git commit -am *' 'make fmt' 'make fmt-check'; do
	check "settings allow Bash($c)" "any(.permissions.allow[]; . == \"Bash($c)\")" "$S"
done
for c in 'git commit * -F*' 'git commit * --fil*' 'git commit * --templ*' 'git commit * --no-v*' 'git commit * -n*' 'git commit * -qn*' 'git commit * -qF*' \
	'git commit * --amend' 'git commit * --am *' 'git commit * --ame' 'git add *--paths*' 'git commit *--paths*' 'git * push *' 'git * reset *' 'git * rebase *' \
	'git config *' 'git hook *' 'git *--force*'; do
	check "settings deny Bash($c)" "any(.permissions.deny[]; . == \"Bash($c)\")" "$S"
done
# Direct gofmt is not allowed (deny globs match raw text, so quoted or variable paths would escape); no gofmt-specific rules remain.
check "settings do not allow gofmt or gofmt *" '[.permissions.allow[] | select(test("^Bash\\(gofmt"))] | length == 0' "$S"
check "settings have no gofmt deny entries" '[.permissions.deny[] | select(test("gofmt"))] | length == 0' "$S"
# Evaluate the allow and deny globs over sample commands: a command is blocked when a deny glob matches it.
# bash's * matches any string, as the permission matcher's does; the sampled patterns use nothing else.
denied() { # command: succeeds when some Bash deny glob matches
	local p
	while IFS= read -r p; do
		p=${p#Bash(}
		p=${p%)}
		# shellcheck disable=SC2053
		[[ $1 == $p ]] && return 0
	done < <(printf '%s' "$S" | jq -r '.permissions.deny[] | select(startswith("Bash("))')
	return 1
}
allowed() { # command: succeeds when some Bash allow glob matches
	local p
	while IFS= read -r p; do
		p=${p#Bash(}
		p=${p%)}
		# shellcheck disable=SC2053
		[[ $1 == $p ]] && return 0
	done < <(printf '%s' "$S" | jq -r '.permissions.allow[] | select(startswith("Bash("))')
	return 1
}
for c in 'git commit -m x --amen' 'git commit -q -m x --amend' 'git commit -m x --am' 'git commit -m x --amen --no-edit'; do
	if allowed "$c" && denied "$c"; then
		echo "PASS allowed prefix but denied: $c"
	else
		echo "FAIL expected a deny to match (and an allow to match first): $c"
		fail=1
	fi
done
for c in 'make fmt' 'git commit -q -m "W1-1: tests"' 'git commit -am "W1-1: impl"'; do
	if allowed "$c" && ! denied "$c"; then
		echo "PASS allowed and not denied: $c"
	else
		echo "FAIL expected allow without deny: $c"
		fail=1
	fi
done
for c in 'gofmt -l .' 'gofmt -w "/abs/x"' "gofmt -w '/tmp/x'" 'gofmt -w $HOME/x'; do
	if allowed "$c"; then
		echo "FAIL expected no allow to match: $c"
		fail=1
	else
		echo "PASS not allowed: $c"
	fi
done
check "settings do not deny git add -n" 'any(.permissions.deny[]; test("^Bash\\(git add [^)]*-n")) | not' "$S"
# An allowed commit starts with one of these prefixes, so -F, -t, -n, --amend and friends cannot lead the command.
check "git commit allows start only with a safe flag then -m" '[.permissions.allow[] | select(startswith("Bash(git commit "))] | all(test("^Bash\\(git commit (-m|-q -m|-qm|--quiet -m|-a -m|-am|-s -m|-sm|--allow-empty -m) \\*\\)$"))' "$S"

# 11b. go version and go env are read-only queries; go env cannot write configuration.
for c in 'go version' 'go env' 'go env *'; do
	check "settings allow Bash($c)" "any(.permissions.allow[]; . == \"Bash($c)\")" "$S"
done
for c in 'go version' 'go env' 'go env GOPATH' 'go env GOMODCACHE GOFLAGS' 'go env -json'; do
	if allowed "$c" && ! denied "$c"; then
		echo "PASS allowed and not denied: $c"
	else
		echo "FAIL expected allow without deny: $c"
		fail=1
	fi
done
for c in 'go env -w GOFLAGS=-mod=mod' 'go env -w GOPROXY=off' 'go env -u GOFLAGS' 'go env GOFLAGS -w' 'go env -json -w GOPATH=/x' 'go env --w GOPATH=/x' 'go get example.com/m@v1.0.0' 'go install example.com/m@v1.0.0' 'go run ./x'; do
	if denied "$c"; then
		echo "PASS denied: $c"
	else
		echo "FAIL expected a deny to match: $c"
		fail=1
	fi
done
for c in 'go version -m /bin/ls' 'go mod tidy'; do
	if allowed "$c"; then
		echo "FAIL expected no allow to match: $c"
		fail=1
	else
		echo "PASS not allowed: $c"
	fi
done

# 12. The harness fetches the ticket's dependencies before the impl session; the model never runs go get.
# A local module proxy stands in for the network. Go settings reach the fetch only through GO_FETCH_VARS.
mkproxy() { # module version [go version]: writes a one-package module into the file proxy
	local m=$1 v=$2 g=${3:-1.21} d=$TMP/proxy/$1/@v
	mkdir -p "$d"
	printf '{"Version":"%s","Time":"2020-01-01T00:00:00Z"}' "$v" >"$d/$v.info"
	printf 'module %s\n\ngo %s\n' "$m" "$g" >"$d/$v.mod"
	printf '%s\n' "$v" >"$d/list"
	python3 -I - "$m" "$v" "$d/$v.zip" "$g" <<'PY'
import sys, zipfile
m, v, out, g = sys.argv[1:]
with zipfile.ZipFile(out, "w") as z:
    z.writestr(f"{m}@{v}/go.mod", f"module {m}\n\ngo {g}\n")
    z.writestr(f"{m}@{v}/dep.go", "package dep\n")
PY
}
mkproxy example.com/dep v1.0.0
mkproxy example.com/dep2 v1.2.3
mkproxy example.com/evil v1.0.0
mkproxy example.com/newgo v1.0.0 1.99
export GOPROXY=file://$TMP/proxy GOSUMDB=off GOMODCACHE=$TMP/modcache
# A harness that inherited -mod=readonly could not run go get; it must not pass this on.
export GOFLAGS=-mod=readonly

fake3() { # id, dependencies lines, allow lines
	cat <<EOF
---
id: $1
level: standard
packages:
  - pkg/calc
allow:
$3
tests: []
dependencies:
$2
---

# Use a dependency
EOF
}
GOALLOW='  - go.mod
  - go.sum'
export CLAUDE_BIN=$TMP/fake-claude CLAUDE_FAKE_PLAN=$TMP/plan.json CLAUDE_FAKE_OUT=$TMP/session-settings.json
started() { # id, dependencies lines, allow lines: writes the ticket and starts it
	fake3 "$1" "$2" "$3" >"$TICKET_ROOT/docs/tickets/$1.md"
	"$TICKET" start "$1" >/dev/null
}
fetch_blocked='.state == "impl_blocked" and .needs_human == true'

# A dependency with no version blocks impl; no model session starts.
started FAKE-3 '  - example.com/dep' "$GOALLOW"
rm -f "$CLAUDE_FAKE_OUT"
out=$("$TICKET" impl FAKE-3)
check "dependency without a version blocks impl" "$fetch_blocked and (.reason | contains(\"needs a version\")) and (.reason | contains(\"example.com/dep\"))" "$out"
[ ! -e "$CLAUDE_FAKE_OUT" ] && echo "PASS no model session for an unversioned dependency" || { echo "FAIL a model session ran"; fail=1; }
check "dry run rejects an unversioned dependency" '.state == "error" and (.reason | contains("needs a version"))' "$("$TICKET" run FAKE-3 --dry-run)"
for e in 'example.com/dep latest' 'example.com/dep@latest' 'example.com/dep 1.0.0' '-u v1.0.0' 'example.com/dep v1.0.0 v1.0.1' 'example.com/dep v1' 'example.com/dep@v1.2' 'example.com/dep v2dev' 'example.com/... v1.0.0'; do
	fake3 FAKE-3 "  - $e" "$GOALLOW" >"$TICKET_ROOT/.ticket/FAKE-3/ticket.md"
	check "dependency '$e' blocks impl" "$fetch_blocked and (.reason | contains(\"needs a version\"))" "$("$TICKET" impl FAKE-3)"
done

# go.mod and go.sum must be in allow, or verify would reject the fetched change.
fake3 FAKE-3 '  - example.com/dep v1.0.0' '  - pkg/calc' >"$TICKET_ROOT/.ticket/FAKE-3/ticket.md"
check "dependencies without go.mod and go.sum in allow block impl" "$fetch_blocked and (.reason | contains(\"go.mod and go.sum\"))" "$("$TICKET" impl FAKE-3)"

# A module the proxy does not have fails go get; no model session starts.
fake3 FAKE-3 '  - example.com/missing v1.0.0' "$GOALLOW" >"$TICKET_ROOT/.ticket/FAKE-3/ticket.md"
rm -f "$CLAUDE_FAKE_OUT"
out=$("$TICKET" impl FAKE-3)
check "a failing go get blocks impl" "$fetch_blocked and (.reason | contains(\"go get or go mod tidy failed\")) and (.reason | contains(\"deps.log\"))" "$out"
[ ! -e "$CLAUDE_FAKE_OUT" ] && echo "PASS no model session after a failed go get" || { echo "FAIL a model session ran"; fail=1; }

# Both version spellings are fetched, in the worktree, uncommitted, before the model session. example.com/adr-named is named by an ADR only: not fetched.
fake3 FAKE-3 '  - example.com/dep v1.0.0
  - example.com/dep2@v1.2.3' "$GOALLOW" >"$TICKET_ROOT/.ticket/FAKE-3/ticket.md"
WT3=$TMP/repo.worktrees/FAKE-3
HEAD3=$(git -C "$WT3" rev-parse HEAD)
rm -f "$CLAUDE_FAKE_OUT"
out=$("$TICKET" impl FAKE-3)
check "impl retried from impl_blocked fetches, then starts the session" '.state == "impl_blocked" and (.reason | contains("fake stop"))' "$out"
[ -e "$CLAUDE_FAKE_OUT" ] && echo "PASS the model session started after the fetch" || { echo "FAIL no model session"; fail=1; }
M=$(cat "$WT3/go.mod")
check "go.mod requires the 'module version' dependency" 'contains("example.com/dep v1.0.0")' "$(jq -Rs . <<<"$M")"
check "go.mod requires the 'module@version' dependency" 'contains("example.com/dep2 v1.2.3")' "$(jq -Rs . <<<"$M")"
check "go.mod has no ADR-only dependency" 'contains("adr-named") | not' "$(jq -Rs . <<<"$M")"
check "go.sum has the fetched modules" 'contains("example.com/dep v1.0.0 h1:") and contains("example.com/dep2 v1.2.3 h1:")' "$(jq -Rs . <"$WT3/go.sum")"
[ "$(git -C "$WT3" rev-parse HEAD)" = "$HEAD3" ] && echo "PASS the harness commits nothing" || { echo "FAIL the harness committed"; fail=1; }
check "go.mod and go.sum are left modified for the session" '(map(select(.[3:] == "go.mod" or .[3:] == "go.sum")) | length) == 2' "$(git -C "$WT3" status --porcelain | jq -R . | jq -s .)"
# Running it again with the modules already present changes nothing.
S1=$(shasum -a 256 "$WT3/go.mod" "$WT3/go.sum")
check "a second impl fetch succeeds" '.state == "impl_blocked" and (.reason | contains("fake stop"))' "$("$TICKET" impl FAKE-3)"
[ "$(shasum -a 256 "$WT3/go.mod" "$WT3/go.sum")" = "$S1" ] && echo "PASS the second fetch is a no-op" || { echo "FAIL the second fetch changed go.mod or go.sum"; fail=1; }

# Only the ticket's own dependencies are fetched: code that imports an unlisted module does not get it looked up and added.
started FAKE-5 '  - example.com/dep v1.0.0' "$GOALLOW"
WT5=$TMP/repo.worktrees/FAKE-5
printf 'package calc\n\nimport _ "example.com/evil"\n' >"$WT5/pkg/calc/evil.go"
git -C "$WT5" add pkg/calc/evil.go && git -C "$WT5" -c user.name=t -c user.email=t@t commit -q -m "import an unlisted module"
jq '.state = "verify_failed"' "$TICKET_ROOT/.ticket/FAKE-5/state.json" >"$TMP/state.json" && cp "$TMP/state.json" "$TICKET_ROOT/.ticket/FAKE-5/state.json"
rm -f "$CLAUDE_FAKE_OUT"
out=$("$TICKET" impl FAKE-5)
check "an import of an unlisted module blocks impl, naming it" "$fetch_blocked and (.reason | contains(\"example.com/evil\"))" "$out"
[ ! -e "$CLAUDE_FAKE_OUT" ] && echo "PASS no model session after an unlisted import" || { echo "FAIL a model session ran"; fail=1; }
grep -q 'example.com/evil' "$WT5/go.mod" "$WT5/go.sum" && { echo "FAIL the unlisted module was added to go.mod or go.sum"; fail=1; } || echo "PASS the unlisted module is not in go.mod or go.sum"

# A listed module that needs a newer go than the worktree's is not allowed to raise go.mod's go line or switch toolchains.
started FAKE-6 '  - example.com/newgo v1.0.0' "$GOALLOW"
WT6=$TMP/repo.worktrees/FAKE-6
G6=$(grep -E '^(go|toolchain) ' "$WT6/go.mod")
rm -f "$CLAUDE_FAKE_OUT"
out=$("$TICKET" impl FAKE-6)
check "a dependency needing a newer go blocks impl" "$fetch_blocked and (.reason | contains(\"go get or go mod tidy failed\"))" "$out"
[ "$(grep -E '^(go|toolchain) ' "$WT6/go.mod")" = "$G6" ] && echo "PASS the go and toolchain lines are unchanged" || { echo "FAIL go.mod's go or toolchain line changed"; fail=1; }
[ ! -e "$CLAUDE_FAKE_OUT" ] && echo "PASS no model session for a dependency needing a newer go" || { echo "FAIL a model session ran"; fail=1; }

# A ticket with no dependencies fetches nothing.
started FAKE-4 '' "$GOALLOW"
sed -i.bak '/^dependencies:/d' "$TICKET_ROOT/.ticket/FAKE-4/ticket.md" && rm -f "$TICKET_ROOT/.ticket/FAKE-4/ticket.md.bak"
"$TICKET" impl FAKE-4 >/dev/null
[ ! -e "$TICKET_ROOT/.ticket/FAKE-4/deps.log" ] && git -C "$TMP/repo.worktrees/FAKE-4" diff --quiet && echo "PASS no dependencies, no fetch" || { echo "FAIL a fetch ran without dependencies"; fail=1; }

# The prompts tell the model not to run go get, and to use one command per Bash call.
P=$TICKET_ROOT/.ticket/FAKE-3/impl.prompt.md
for f in "$P" "$TICKET_ROOT/.ticket/FAKE-2/tests.prompt.md"; do
	for s in 'Run exactly one command per Bash call' "Never chain commands with ';', '|' or '&&'" 'retry with a simpler allowed single command' 'one denial does not mean Bash is unavailable' 'only after several distinct allowed commands have failed'; do
		grep -qF -- "$s" "$f" && echo "PASS $(basename "$f") says: $s" || { echo "FAIL $(basename "$f") lacks: $s"; fail=1; }
	done
done
grep -qF 'The harness already ran go get and go mod tidy' "$P" && grep -qF 'cannot run go get' "$P" && echo "PASS impl prompt: the harness fetches, the model does not run go get" || { echo "FAIL impl prompt about go get"; fail=1; }
grep -qF 'adding a dependency' "$P" && { echo "FAIL impl prompt still tells the model to add dependencies"; fail=1; } || echo "PASS impl prompt does not tell the model to add dependencies"
grep -qF 'a new dependency: stop and report blocked' "$P" && echo "PASS impl prompt: an unexpected dependency still blocks" || { echo "FAIL impl prompt: unexpected dependency rule"; fail=1; }
# The fix prompt: one finding, in a review that sits in review.json.
jq '.state = "review_findings"' "$TICKET_ROOT/.ticket/FAKE-3/state.json" >"$TMP/state.json" && cp "$TMP/state.json" "$TICKET_ROOT/.ticket/FAKE-3/state.json"
printf '{"verdict":"fail","checked":[],"findings":[{"severity":"major","category":"x","file":"f.go","line":1,"what_breaks":"b","failing_scenario":"s","suggested_test":"t"}]}' >"$TICKET_ROOT/.ticket/FAKE-3/review.json"
"$TICKET" fix FAKE-3 >/dev/null
for s in 'Run exactly one command per Bash call' "Never chain commands with ';', '|' or '&&'" 'retry with a simpler allowed single command' 'only after several distinct allowed commands have failed'; do
	grep -qF -- "$s" "$TICKET_ROOT/.ticket/FAKE-3/fix.prompt.md" && echo "PASS fix prompt says: $s" || { echo "FAIL fix prompt lacks: $s"; fail=1; }
done
unset CLAUDE_BIN CLAUDE_FAKE_PLAN CLAUDE_FAKE_OUT GOPROXY GOSUMDB GOMODCACHE GOFLAGS

# 7. Dry run needs no Claude and prints one line.
out=$("$TICKET" run FAKE-1 --dry-run)
check "dry run reports the pipeline" '.state == "dry_run"' "$out"

out=$("$TICKET" reset FAKE-1 --yes)
check "reset removes the worktree" '.state == "reset"' "$out"
[ ! -e "$WT" ] || { echo "FAIL reset left $WT"; fail=1; }

[ $fail -eq 0 ] && echo "all harness tests passed"
exit $fail
